# =====================================================================
#  Market Files — environment settings
#  $0 LAUNCH: everything marked FREE works without paying anything.
# =====================================================================

# Your site address (the free Vercel one works: https://market-files.vercel.app)
SITE_URL=https://market-files.vercel.app

# ---- Research box ----
# FREE: Google Programmable Search (https://programmablesearchengine.google.com). Create a search
# engine set to "Search the entire web", copy its Search engine ID here. Results show inside the site.
# Leave blank to open Google in a new tab instead.
GOOGLE_CSE_ID=
# OPTIONAL, PAID: add an Anthropic key to switch the research box to Market Files AI (Claude).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_QUICK=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_DEEP=claude-opus-5-5
AI_WEB_SEARCH=true
AI_WEB_SEARCH_MAX_USES=3
AI_RATE_LIMIT=20

# ---- Market data (all FREE tiers) ----
MARKET_DATA=live
FINNHUB_API_KEY=          # FREE key: https://finnhub.io (stocks & ETFs)
FRED_API_KEY=             # FREE key: https://fred.stlouisfed.org/docs/api/api_key.html (yields, rates, inflation)
COINGECKO_API_KEY=        # optional; works without a key
FX_API_BASE=https://api.frankfurter.app
# Futures prices & charts: FREE via TradingView widgets (on by default). Set to false to hide them.
TRADINGVIEW=true
# Optional: your own licensed futures feed (only if you later want futures numbers in the site's own tiles)
FUTURES_FEED_URL=
FUTURES_FEED_TOKEN=

# ---- Database (FREE Supabase tier). Without it the site serves built-in content read-only.
DATABASE_URL=

# ---- Editor sign-in at /admin
ADMIN_PASSWORD=
ADMIN_SECRET=

# ---- Newsletter (FREE Beehiiv tier) — optional
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
